enum IpRuleType {
  whitelist
  blacklist
}

model IpRule {
  id        Int        @id @default(autoincrement())
  ipAddress String     @unique @db.VarChar(45)
  type      IpRuleType
  label     String?    @db.VarChar(255)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([type])
  @@map("ip_rules")
}

enum ProxyStatus {
  untested
  active
  quarantine
  dead
}

// Un proxy sortant utilisable par les fetchers géo-bloqués ou filtrés par
// réputation d'IP. Remplace les proxies codés en dur (cf. docs/PROXY_POOL.md).
//
// ⚠️ Le pool est alimenté par des sources PUBLIQUES et éphémères : une ligne
// n'est pas un actif durable, elle vit quelques heures à quelques jours. C'est
// le renouvellement continu (harvester) et non la longévité d'une entrée qui
// rend le service disponible.
model Proxy {
  id       Int     @id @default(autoincrement())
  protocol String  @default("http") @db.VarChar(10)
  host     String  @db.VarChar(45)
  port     Int
  // Proxies authentifiés (payants). Jamais renseignés par le harvester.
  username String? @db.VarChar(255)
  password String? @db.VarChar(255)

  // ISO-2 de l'IP du proxy. Annoncé par la source ; c'est le seul discriminant
  // qui compte pour une cible géo-bloquée (Happy Valley exige CN).
  country String? @db.VarChar(2)
  // "proxyscrape" | "geonode" | "monosans" | "manual"
  source  String  @db.VarChar(30)
  label   String? @db.VarChar(255)

  status  ProxyStatus @default(untested)
  // Retiré du pool à la main depuis l'admin : ni testé, ni servi. Distinct de
  // `dead`, que le checker peut réhabiliter tout seul au prochain passage.
  enabled Boolean     @default(true)

  latencyMs Int?
  failCount Int     @default(0)
  lastError String? @db.VarChar(255)

  // Posé par l'admin (bouton « Test proxies ») pour réclamer une vérification
  // immédiate ; le checker le remet à null quand il a fini. C'est ce qui rend
  // un proxy ajouté à la main utilisable en une minute au lieu d'une heure.
  checkRequestedAt DateTime?

  lastCheckedAt DateTime?
  lastOkAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  targets ProxyTarget[]

  @@unique([host, port])
  @@index([country, status])
  @@index([status, enabled])
  @@index([checkRequestedAt])
  @@map("proxies")
}

// Résultat du test d'un proxy contre UNE cible.
//
// ⚠️ C'est CE lien que le worker requête, jamais `Proxy.status` seul : un proxy
// « vivant » ne débloque pas forcément telle cible (WAF propre, IP bannie,
// latence). Mesuré le 2026-08-11 sur un même échantillon de 60 proxies publics :
// 20 passaient Beto Carrero, 17 PortAventura et seulement 7 Puy du Fou.
model ProxyTarget {
  id      Int    @id @default(autoincrement())
  proxyId Int
  proxy   Proxy  @relation(fields: [proxyId], references: [id], onDelete: Cascade)
  // Identifiant du registre `src/services/proxy/targets.ts` : un provider
  // ("happy-valley", "puy-du-fou") ou un parc custom ("beto-carrero-world").
  target  String @db.VarChar(60)

  ok        Boolean
  latencyMs Int?
  // Ce qui a fait échouer le test (code HTTP, code réseau) — sinon un `ok=false`
  // ne dit pas si le proxy est mort ou si la cible l'a refusé.
  error     String?  @db.VarChar(255)
  checkedAt DateTime @default(now())

  @@unique([proxyId, target])
  @@index([target, ok])
  @@map("proxy_targets")
}

model Report {
  id             Int       @id @default(autoincrement())
  parkIdentifier String    @db.VarChar(100)
  category       String    @db.VarChar(50)
  subcategory    String    @db.VarChar(50)
  details        String    @db.Text
  email          String    @db.VarChar(255)
  locale         String    @db.VarChar(10)
  ipAddress      String    @db.VarChar(45)
  userAgent      String?   @db.Text
  resolved       Boolean   @default(false)
  resolution     String?   @db.VarChar(50)
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  // ⚠️ TRACE DE LA RÉPONSE (ajout 2026-08-18). `resolution` ne dit que la
  // CATÉGORIE du verdict ; le texte réellement envoyé à l'utilisateur était
  // saisi dans l'admin, expédié par Resend, puis perdu. Mesuré à l'ajout :
  // 66 réponses envoyées, 0 conservée. Conséquences concrètes : impossible de
  // savoir ce qu'on avait répondu à quelqu'un, impossible d'être cohérent d'un
  // signalement au suivant, et une résolution « Doublon » qui ne pouvait
  // renvoyer vers rien.
  responseLabel   String?   @db.VarChar(255)
  responseMessage String?   @db.Text
  // E-mail de l'admin qui a tranché (session NextAuth), pas un identifiant.
  resolvedBy      String?   @db.VarChar(255)
  // Réception de l'e-mail. ⚠️ `emailSentAt` n'est posé QUE si Resend a accepté
  // l'envoi : l'échec était auparavant avalé par un `catch` qui n'écrivait
  // qu'en console, si bien que le signalement passait `resolved` alors que
  // l'utilisateur n'avait jamais rien reçu — et rien ne permettait de le voir.
  emailSentAt     DateTime?
  emailError      String?   @db.Text
  // Renseigné quand `resolution = "duplicate"` : le signalement d'origine.
  // Volontairement PAS une relation Prisma — une auto-relation imposerait un
  // champ inverse et une cascade à décider pour un simple renvoi humain.
  duplicateOfId   Int?

  @@index([parkIdentifier])
  @@index([category])
  @@index([createdAt])
  @@index([resolved])
  @@map("reports")
}

// Catalogue des réponses proposées à l'admin au moment de clore un signalement.
// EN BASE et non plus en dur dans `lib/report-config.ts` : les textes se
// retouchent depuis /report-templates sans redéployer deux dépôts.
//
// ⚠️ `value` est la valeur écrite dans `Report.resolution`. La RENOMMER
// orpheline l'historique — 30 signalements portent déjà `not-our-side`, qui a
// été relibellé sans changer de valeur pour cette raison exacte. Ajouter une
// entrée : oui. Renommer une entrée existante : jamais.
//
// ⚠️ Le code reste la SOURCE DE SECOURS : `DEFAULT_RESOLUTION_OPTIONS` sert de
// graine et de repli tant que la table est vide, pour qu'un déploiement sans
// seed n'affiche pas un sélecteur vide.
model ReportTemplate {
  id        Int      @id @default(autoincrement())
  value     String   @unique @db.VarChar(50)
  labelFr   String   @db.VarChar(255)
  labelEn   String   @db.VarChar(255)
  messageFr String   @db.Text
  messageEn String   @db.Text
  // Classes Tailwind de la pastille, mêmes conventions que le reste de l'admin.
  color     String   @db.VarChar(160)
  sortOrder Int      @default(0)
  // Retirée du sélecteur sans être supprimée : les anciens signalements qui la
  // portent continuent de s'afficher avec leur libellé.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("report_templates")
}

// Instantané QUOTIDIEN des huit compteurs d'alerte du dashboard.
//
// Sert UNIQUEMENT à afficher une tendance : « 9 parcs figés » ne dit pas si
// c'est mieux ou pire qu'hier, et c'est pourtant la première question qu'on se
// pose devant le chiffre.
//
// ⚠️ Écrit à l'OUVERTURE du dashboard, pas par un cron. Un jour sans visite n'a
// donc pas de ligne, et c'est assumé : la tendance ne sert qu'à celui qui
// regarde la page. Le delta se compare au dernier jour CONNU — dont la date est
// affichée — et jamais à « hier » supposé, qui pourrait ne pas exister.
//
// Une ligne par jour, huit entiers : ~36 Ko par an.
model HealthSnapshot {
  id Int @id @default(autoincrement())

  // Jour local dans le fuseau EUROPE/PARIS, comme l'horodatage affiché en
  // en-tête du dashboard.
  date String @unique @db.VarChar(10)

  // Rangée 1 des vignettes — LA COLLECTE : ce que la machine signale.
  parksWithoutData Int @default(0)
  frozenParks      Int @default(0)
  jobsFailed24h    Int @default(0)
  frozenRides      Int @default(0)

  // Rangée 2 — LA FILE DE TRAVAIL : ce qui attend une main humaine.
  openReports       Int @default(0)
  unknownStatuses   Int @default(0)
  unmatchedAlerts   Int @default(0)
  parksWithoutShows Int @default(0)

  // ⚠️ CONSERVÉE alors que sa vignette a quitté la grille d'alertes le
  // 2026-08-18 (descendue dans la vue d'ensemble, remplacée par
  // `openReports`). L'historique déjà collecté a de la valeur et la colonne
  // coûte un entier par jour : la supprimer détruirait la série pour rien.
  errorLogs24h Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("health_snapshots")
}

//
// CAPTURE DES RÉPONSES BRUTES DES APIS DE PARCS
//
// Deux tables et un principe : la collecte enregistre EN PERMANENCE la dernière
// réponse de chaque appel (`raw_api_latest`, écrasée à chaque passage), et un
// déclencheur — statut inconnu, signalement — en fige une copie
// (`raw_api_captures`, jamais écrasée).
//
// ⚠️ **Pourquoi enregistrer tout le temps plutôt qu'au moment du besoin.** La
// première version rappelait les endpoints du parc quand un signalement
// arrivait. C'était faux : la réponse d'il y a quarante minutes n'est pas une
// version dégradée de la réponse fraîche, c'est CELLE QUI A PRODUIT ce que le
// visiteur avait sous les yeux. Rappeler l'API va chercher un autre état que
// celui qu'on cherche à comprendre — et coûte en plus des appels
// supplémentaires aux parcs, une désactivation du cache disque et un
// garde-fou contre le martèlement. Enregistrer en continu supprime les trois.
//
// ⚠️ **Le corps est toujours compressé** (gzip niveau 1). Du JSON de parc se
// compresse d'un facteur 10 à 20 : c'est ce qui rend le débit d'écriture de la
// photo — réécrite chaque minute pour les temps d'attente — supportable sur une
// base qui encaisse déjà `wait_times`.
//

// La DERNIÈRE réponse connue de chaque appel d'API, par parc.
//
// ⚠️ **Table à taille FIXE**, et c'est sa propriété essentielle : ~230 parcs ×
// quelques appels ≈ 1 000 à 1 500 lignes, écrasées à chaque passage. Elle ne
// grossit jamais, donc elle n'a pas besoin de purge.
//
// ⚠️ **Un parc dont le passage n'a émis AUCUN appel garde sa photo précédente**
// plutôt que de la perdre. Ça arrive vraiment : les huit parcs Disney d'une même
// région se partagent une réponse mise en cache 30 s, si bien qu'un seul émet
// l'appel HTTP et que les sept autres n'ont rien à enregistrer ce tour-ci. Leur
// photo a alors quelques minutes, ce qui vaut infiniment mieux que rien.
model RawApiLatest {
  id Int @id @default(autoincrement())

  /// `parks.identifier`, tel qu'utilisé partout ailleurs.
  parkId  String @db.VarChar(100)
  /// `waitTimes` | `openingHours` | `shows` | `poi`.
  fetcher String @db.VarChar(20)
  /// Rang de l'appel DANS le passage de ce fetcher, à partir de 0.
  ///
  /// ⚠️ C'est la granularité demandée : un service peut émettre plusieurs
  /// appels (authentification puis données, une requête par mois), et deux
  /// services peuvent taper la même URL. Une ligne = un appel, pas un service.
  seq     Int

  method String @db.VarChar(10)
  /// Tronquée à 1 000 caractères. Jamais indexée : on ne cherche pas par URL.
  url    String @db.VarChar(1000)

  /// `null` quand aucune réponse n'est parvenue (timeout, DNS, refus de
  /// connexion). La ligne est écrite quand même : un échec est souvent
  /// l'explication du signalement qu'on est en train de lire.
  statusCode  Int?
  contentType String? @db.VarChar(120)
  durationMs  Int?
  /// Message d'échec (code HTTP, code réseau), quand il y en a un.
  error       String? @db.VarChar(255)

  /// Taille du corps AVANT compression, en octets. Affichée telle quelle par
  /// l'admin — `LENGTH(bodyGzip)` ne dirait rien de lisible.
  bodySize  Int
  /// Corps gzippé, ou `null` quand il n'y a rien d'exploitable à garder :
  /// réponse binaire (ZIP, images) ou flux consommé par le fetcher. Les
  /// métadonnées de la ligne, elles, sont conservées dans tous les cas.
  bodyGzip  Bytes?  @db.MediumBlob
  /// Vrai si le corps dépassait le plafond et n'a été gardé que partiellement.
  truncated Boolean @default(false)

  fetchedAt DateTime

  @@unique([parkId, fetcher, seq])
  @@index([parkId])
  @@map("raw_api_latest")
}

// Copie FIGÉE d'une photo, prise au moment d'un statut inconnu ou d'un
// signalement.
//
// ⚠️ **Le corps est recopié, jamais référencé.** Pointer vers `raw_api_latest`
// serait plus économe pendant une minute et vide de sens ensuite : la photo est
// écrasée au passage suivant. Une capture doit se suffire à elle-même.
//
// ⚠️ **Aucune purge.** Le volume est piloté par le nombre de statuts inconnus et
// de signalements — quelques-uns par jour, à quelques kilo-octets compressés la
// ligne. L'historique complet coûte moins cher que la logique de rétention qu'il
// faudrait écrire pour l'éviter.
model RawApiCapture {
  id Int @id @default(autoincrement())

  /// `unknown_status` | `report`.
  ///
  /// ⚠️ **Pas de valeur « manuelle », et ce n'est pas un oubli.** Une capture
  /// ne vaut que parce qu'elle contient l'état qui a PRODUIT l'incident ; une
  /// copie rattachée après coup contiendrait l'état de maintenant et se lirait
  /// exactement pareil. Pour voir ce qu'une source publie à l'instant, c'est
  /// `raw_api_latest` qu'on ouvre, depuis la liste des parcs de l'admin.
  ///
  /// ⚠️ Nommée `triggerType` et pas `trigger` : `TRIGGER` est un mot réservé
  /// MySQL, et une colonne qui l'est oblige à l'échapper dans le moindre SQL
  /// écrit à la main — dont la recopie de `raw_api_latest`.
  triggerType     String @db.VarChar(20)
  /// `unknown_statuses.id` ou `reports.id` selon `trigger`.
  ///
  /// Volontairement PAS une relation Prisma : la cible dépend du déclencheur,
  /// et une capture doit survivre à la suppression de ce qui l'a déclenchée —
  /// c'est justement le moment où on la relit.
  unknownStatusId Int?
  reportId        Int?

  parkId  String @db.VarChar(100)
  fetcher String @db.VarChar(20)
  seq     Int

  method String @db.VarChar(10)
  url    String @db.VarChar(1000)

  statusCode  Int?
  contentType String? @db.VarChar(120)
  durationMs  Int?
  error       String? @db.VarChar(255)

  bodySize  Int
  bodyGzip  Bytes?  @db.MediumBlob
  truncated Boolean @default(false)

  /// Horodatage de l'APPEL, repris de la photo — pas celui de la capture. C'est
  /// lui qui dit à quel point la réponse était fraîche au moment du
  /// déclenchement.
  fetchedAt  DateTime
  capturedAt DateTime @default(now())

  @@index([reportId])
  @@index([unknownStatusId])
  @@map("raw_api_captures")
}
